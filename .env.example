# ============================================================================
# StoneQuarryERP — environment variables template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env / .env.local — they are already in .gitignore.
# NEVER put a service-role key in a VITE_ prefixed variable — anything
# prefixed VITE_ is bundled into the browser and is PUBLIC.
# ============================================================================

# ---------------------------------------------------------------------------
# CENTRAL registry project (Main Branch / business directory, central users,
# central_user_business_access, central_audit_logs). Small, low-traffic.
# ---------------------------------------------------------------------------
# (Not used by the app today — there is no Central project. Leave unset.)
# VITE_CENTRAL_SUPABASE_URL=
# VITE_CENTRAL_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# KMG STONES — isolated operational project (customers, quotations, bills,
# payments, ledger, stock, vehicles, drivers, trips, expenses, audit_logs).
# ---------------------------------------------------------------------------
VITE_KMG_SUPABASE_URL=
VITE_KMG_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# MURUDESHWARA STONES — isolated operational project (same shape as KMG).
# ---------------------------------------------------------------------------
VITE_MURUDESHWARA_SUPABASE_URL=
VITE_MURUDESHWARA_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only (Edge Functions / backend). NEVER prefix these with VITE_.
# Used only inside Supabase Edge Functions, never shipped to the browser.
# ---------------------------------------------------------------------------
# CENTRAL_SUPABASE_SERVICE_ROLE_KEY=
# KMG_SUPABASE_SERVICE_ROLE_KEY=
# MURUDESHWARA_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App-level configuration
# ---------------------------------------------------------------------------
VITE_APP_NAME="Stone Business Panel"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
VITE_DEFAULT_CURRENCY="INR"
